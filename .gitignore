# Local venv (canonical dev venv: ../venv/interoves_django — see run_server.sh / run_tests.sh)
.venv/

db.sqlite3
*.pyc
google_token.pickle
# Real credentials and downloads under secrets/ (see secrets/README.md).
secrets/*
!secrets/README.md
!secrets/rds.env.example
!secrets/rds.elasticbeanstalk-env.example
!secrets/aws.env.example
.vscode
.cursor/*
!.cursor/skills/
.cursor/skills/*
!.cursor/skills/interoves-realtime/
!.cursor/skills/interoves-realtime/**
__pycache__
media

# Eurovision booklet: runtime sync cache (PDFs + manifest from git)
var/eurovision_booklet/

# Generated before eb deploy / packaging (see scripts/write_deploy_version.sh)
interoves_django/deploy_version.txt

# Nutrimatic: ship find-expr + cgi_scripts in git so EB deploys from a clean
# checkout still serve /nutrimatic-ru/. Keep the ~350MB index and S3 cache local.
nutrimatic_bundle/*.index
nutrimatic_bundle/.s3_index_cache/
nutrimatic_bundle/**/__pycache__/

.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml
