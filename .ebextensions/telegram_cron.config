# Minute cron for Telegram game announcements + daily ladder channel schedule (00:15 MSK)
# and immediate X tweet of the same ladder teaser.
# Daily-game difficulty refresh lives in difficulty_cron.config so a Telegram
# failure cannot block ratings, and vice versa.
# Django uses Europe/Moscow for the window; EB instance TZ is MSK.
# Script is installed via files: (not copied from /var/app/current — that path is
# not ready yet during container_commands / PostBuild).
files:
  "/opt/interoves/telegram_cron.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Minute cron: Telegram announcements + ladder channel tick (00:15 MSK).
      set -euo pipefail
      APP_DIR=/var/app/current
      LOG=/var/log/telegram_cron.log
      LOCK=/var/lock/telegram_cron.lock
      exec 9>"$LOCK"
      if ! flock -n 9; then
        exit 0
      fi
      # EB environment secrets are present in Daphne's environment, but not
      # get-config environment. Copy it so cron can initialize Django/TG.
      eval "$(python3 -c '
      import shlex, subprocess, sys
      pid = subprocess.check_output(["pgrep", "-of", "daphne"], text=True).strip()
      if not pid:
          sys.exit("Daphne process not found; cannot load EB environment")
      with open("/proc/{}/environ".format(pid), "rb") as source:
          values = source.read().decode().split(chr(0))
      for item in values:
          if "=" in item:
              key, value = item.split("=", 1)
              print("export {}={}".format(key, shlex.quote(value)))
      ')"
      cd "$APP_DIR"
      # shellcheck disable=SC1091
      source /var/app/venv/*/bin/activate
      # Cron runs as root; Playwright Chromium lives under webapp (playwright.config).
      # Without this path, ladder screenshots fall back to Pillow (broken Cyrillic).
      export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-/home/webapp/.cache/ms-playwright}"
      run_tracked() {
        local queue_name="$1"
        shift
        python manage.py queue_heartbeat --queue "$queue_name" --state start || true
        set +e
        "$@"
        local exit_code=$?
        set -e
        if [ "$exit_code" -eq 0 ]; then
          python manage.py queue_heartbeat --queue "$queue_name" --state success || true
        else
          python manage.py queue_heartbeat --queue "$queue_name" --state failed --error "exit $exit_code" || true
        fi
        return "$exit_code"
      }
      {
        echo "---- $(date -Is) telegram_game_announcements ----"
        # A stuck Chromium/Telethon call must not hold the cron flock forever.
        telegram_failed=0
        run_tracked telegram_game_announcements \
          timeout --foreground --signal=TERM --kill-after=15s 120s \
          python manage.py telegram_game_announcements || telegram_failed=1
        echo "---- $(date -Is) telegram_admin_report ----"
        run_tracked telegram_admin_report \
          timeout --foreground --signal=TERM --kill-after=15s 90s \
          python manage.py telegram_admin_report || telegram_failed=1
        exit "$telegram_failed"
      } >>"$LOG" 2>&1

  "/etc/cron.d/interoves-telegram":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/sbin:/bin:/usr/sbin:/usr/bin
      * * * * * root /opt/interoves/telegram_cron.sh

commands:
  01_telegram_cron_log:
    command: "touch /var/log/telegram_cron.log && chmod 644 /var/log/telegram_cron.log"
