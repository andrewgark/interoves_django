# Durable actor-by-actor Word Salad rechecks.  DB leases make this safe on all
# EB instances and allow a deployment to resume after a worker is killed.
files:
  "/opt/interoves/word_salad_recheck_cron.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail
      APP_DIR=/var/app/current
      LOG=/var/log/word_salad_recheck_cron.log
      LOCK=/var/lock/word_salad_recheck_cron.lock
      exec 9>"$LOCK"
      if ! flock -n 9; then exit 0; fi
      {
        echo "---- $(date -Is) process_word_salad_rechecks ----"
        python3 - "$APP_DIR" <<'PY'
      import glob, os, subprocess, sys
      app_dir = sys.argv[1]
      pid = subprocess.check_output(['pgrep', '-of', 'daphne'], text=True).strip()
      env = os.environ.copy()
      with open('/proc/{}/environ'.format(pid), 'rb') as source:
          for item in source.read().split(b'\0'):
              if b'=' in item:
                  key, value = item.split(b'=', 1)
                  env[key.decode()] = value.decode()
      python = sorted(glob.glob('/var/app/venv/*/bin/python'))[-1]
      subprocess.run([python, 'manage.py', 'process_word_salad_rechecks', '--limit', '1'], cwd=app_dir, env=env, check=True)
      PY
      } >>"$LOG" 2>&1

  "/etc/cron.d/interoves-word-salad-recheck":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/sbin:/bin:/usr/sbin:/usr/bin
      * * * * * root /opt/interoves/word_salad_recheck_cron.sh

commands:
  01_word_salad_recheck_log:
    command: "touch /var/log/word_salad_recheck_cron.log && chmod 644 /var/log/word_salad_recheck_cron.log"
