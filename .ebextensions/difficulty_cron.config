# Minute cron for due daily-game difficulty snapshot refreshes.
# Separate from telegram_cron.config so the two jobs do not share a failure domain.
# Concurrent runs across EB instances are safe: claim uses SELECT FOR UPDATE SKIP LOCKED
# plus a claim token. flock here only avoids two processes on the same machine.
# Script is installed via files: (not copied from /var/app/current).
files:
  "/opt/interoves/difficulty_cron.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Minute cron: claim and refresh due DailyGameDifficulty rows.
      set -euo pipefail
      APP_DIR=/var/app/current
      LOG=/var/log/difficulty_cron.log
      if [[ "${1:-}" == "--health-check" ]]; then
        LOCK=/var/lock/difficulty_healthcheck.lock
      else
        LOCK=/var/lock/difficulty_cron.lock
      fi
      exec 9>"$LOCK"
      if ! flock -n 9; then
        exit 0
      fi
      {
        echo "---- $(date -Is) refresh_daily_difficulty ----"
        python3 - "$APP_DIR" "${1:-}" <<'PY'
      import glob
      import os
      import subprocess
      import sys

      app_dir, mode = sys.argv[1:]
      try:
          pid = subprocess.check_output(['pgrep', '-of', 'daphne'], text=True).strip()
      except subprocess.CalledProcessError as exc:
          raise SystemExit('Could not find the running Daphne process for EB environment') from exc

      env = os.environ.copy()
      with open('/proc/{}/environ'.format(pid), 'rb') as source:
          for item in source.read().split(b'\0'):
              if b'=' in item:
                  key, value = item.split(b'=', 1)
                  env[key.decode()] = value.decode()

      python = sorted(glob.glob('/var/app/venv/*/bin/python'))[-1]
      args = [python, 'manage.py']
      if mode == '--health-check':
          args.append('check_daily_difficulty')
      else:
          args.extend(['refresh_daily_difficulty', '--limit', '10'])
      subprocess.run(args, cwd=app_dir, env=env, check=True)
      PY
      } >>"$LOG" 2>&1

  "/etc/cron.d/interoves-difficulty":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/sbin:/bin:/usr/sbin:/usr/bin
      * * * * * root /opt/interoves/difficulty_cron.sh
      7 * * * * root /opt/interoves/difficulty_cron.sh --health-check

commands:
  01_difficulty_cron_log:
    command: "touch /var/log/difficulty_cron.log && chmod 644 /var/log/difficulty_cron.log"
