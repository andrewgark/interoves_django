container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput --verbosity 2"
    leader_only: true
  02_createsu:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py createsu"
    leader_only: true
  # Leader only: uploads to S3 (USE_S3); avoids OOM on t3.nano followers during parallel deploys.
  03_collectstatic:
    command: "source /var/app/venv/*/bin/activate && bash scripts/collectstatic_if_changed.sh"
    leader_only: true


option_settings:
  # Default is 600s; EB maximum is 3600s.
  aws:elasticbeanstalk:command:
    Timeout: 3600
  aws:elasticbeanstalk:container:python:
    WSGIPath: interoves_django.asgi:application
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: interoves_django.settings
    # Explicit DB-bound sync worker budget: 3 rolling-deploy instances × 4
    # workers leaves room below the RDS max_connections=60 limit.
    ASGI_THREADS: "4"
    DEBUG_ON: FALSE
    IS_PROD: TRUE
    USE_S3: TRUE
    # Web publishes only a small, non-sensitive admin-alert event; Telegram
    # delivery is performed by the integrations worker.
    INTEGRATIONS_SQS_QUEUE_URL: "https://sqs.eu-central-1.amazonaws.com/916000456640/interoves-integrations"
    # Eurovision booklet 2026: frozen at PINNED_REF (no main tip polling / auto-updates).
    # AUTO_SYNC=FALSE: lazy per-file fetch into var/ on demand (landing/HTML show a loading overlay).
    # Optional: eb setenv EUROVISION_BOOKLET_GITHUB_TOKEN=... (PAT) for API limits.
    EUROVISION_BOOKLET_GITHUB_REPO: "andrewgark/eurovision2026booklet"
    EUROVISION_BOOKLET_GIT_BRANCH: "main"
    EUROVISION_BOOKLET_PINNED_REF: "23be3106b745af459479f9f3d97579e74ecbe939"
    EUROVISION_BOOKLET_AUTO_SYNC: "FALSE"
    EUROVISION_BOOKLET_DIST_PATH: "dist"
    EUROVISION_BOOKLET_HTTP_TIMEOUT: "60"
    EUROVISION_BOOKLET_SYNC_MIN_INTERVAL_SEC: "120"
    RDS_SECRET_ARN: "arn:aws:secretsmanager:eu-central-1:916000456640:secret:rds!db-ce1a594a-9964-4a32-a9d3-9483ada5368c-0O6ead"
    # Nutrimatic (Russian Wikipedia). Index is fetched from S3 into a deploy-stable cache.
    NUTRIMATIC_ROOT: "/var/app/current/nutrimatic_bundle"
    NUTRIMATIC_INDEX_S3_BUCKET: "interoves-django-static"
    NUTRIMATIC_INDEX_S3_KEY: "private/nutrimatic/wiki-merged.packed.index"
    NUTRIMATIC_INDEX_S3_REGION: "eu-central-1"
    NUTRIMATIC_INDEX_CACHE_DIR: "/var/app/nutrimatic_index_cache"
  # Production credentials are fetched by Elastic Beanstalk at instance bootstrap
  # from SSM Parameter Store SecureStrings (free; Secrets Manager charged
  # $0.40/month per variable). Keep the environment variable names unchanged;
  # values remain out of git.
  aws:elasticbeanstalk:application:environmentsecrets:
    ANALYTICS_ANON_SIGNING_KEY: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/ANALYTICS_ANON_SIGNING_KEY"
    AUTH_LOG_FINGERPRINT_KEY: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/AUTH_LOG_FINGERPRINT_KEY"
    DJANGO_SECRET_KEY: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/DJANGO_SECRET_KEY"
    EMAIL_HOST_PASSWORD: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/EMAIL_HOST_PASSWORD"
    INSTAGRAM_ACCESS_TOKEN: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/INSTAGRAM_ACCESS_TOKEN"
    INSTAGRAM_APP_SECRET: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/INSTAGRAM_APP_SECRET"
    NOWPAYMENTS_API_KEY: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/NOWPAYMENTS_API_KEY"
    NOWPAYMENTS_IPN_SECRET: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/NOWPAYMENTS_IPN_SECRET"
    TELEGRAM_API_HASH: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TELEGRAM_API_HASH"
    TELEGRAM_BOT_TOKEN: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TELEGRAM_BOT_TOKEN"
    TELEGRAM_OIDC_CLIENT_SECRET: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TELEGRAM_OIDC_CLIENT_SECRET"
    TELEGRAM_USER_SESSION: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TELEGRAM_USER_SESSION"
    TELEGRAM_WEBHOOK_SECRET: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TELEGRAM_WEBHOOK_SECRET"
    THREADS_ACCESS_TOKEN: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/THREADS_ACCESS_TOKEN"
    TRIBUTE_API_KEY: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TRIBUTE_API_KEY"
    TWITTER_ACCESS_TOKEN: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TWITTER_ACCESS_TOKEN"
    TWITTER_ACCESS_TOKEN_SECRET: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TWITTER_ACCESS_TOKEN_SECRET"
    TWITTER_API_KEY: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TWITTER_API_KEY"
    TWITTER_API_SECRET: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/TWITTER_API_SECRET"
    YANDEX_API_OAUTH_TOKEN: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/YANDEX_API_OAUTH_TOKEN"
    YOOKASSA_SECRET_KEY: "arn:aws:ssm:eu-central-1:916000456640:parameter/interoves/production/YOOKASSA_SECRET_KEY"
