# ASG replaces instances that fail ALB health (EC2 status alone stays "ok" when Daphne hangs).
# HealthCheckType/GracePeriod must be set on AWSEBAutoScalingGroup (not option_settings).
# Grace 600s: boot + yum/playwright packages on a fresh t3.small.
# IgnoreHealthCheck: during deploy Daphne restarts briefly; without this, ELB health
# launches replacement instances mid-deploy and the roll fails (seen 2026-08-04).
#
# CloudWatch alarm + SNS: ./scripts/ensure_eb_health_alarm.sh (see agents/aws-eb.md).
option_settings:
  - namespace: aws:elasticbeanstalk:command
    option_name: IgnoreHealthCheck
    value: 'true'
  - namespace: aws:elasticbeanstalk:environment:process:default
    option_name: HealthCheckInterval
    value: '15'
  - namespace: aws:elasticbeanstalk:environment:process:default
    option_name: HealthCheckTimeout
    value: '5'
  - namespace: aws:elasticbeanstalk:environment:process:default
    option_name: HealthyThresholdCount
    value: '3'
  - namespace: aws:elasticbeanstalk:environment:process:default
    option_name: UnhealthyThresholdCount
    value: '5'
  - namespace: aws:elasticbeanstalk:environment:process:default
    option_name: MatcherHTTPCode
    value: '200'

Resources:
  AWSEBAutoScalingGroup:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      HealthCheckType: ELB
      HealthCheckGracePeriod: 600
