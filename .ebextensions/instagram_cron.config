# Daily cron to keep the long-lived Instagram token alive (03:17 MSK; EB instance TZ is MSK).
# The command self-gates (see instagram_refresh_token): it only calls the API when the stored
# token is older than ~30 days, so a daily schedule refreshes roughly monthly, well within the
# 60-day expiry. Script is installed via files: (not copied from /var/app/current).
files:
  "/opt/interoves/instagram_refresh.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Daily cron: refresh/seed the long-lived Instagram access token (DB-backed).
      set -euo pipefail
      APP_DIR=/var/app/current
      LOG=/var/log/instagram_refresh.log
      LOCK=/var/lock/instagram_refresh.lock
      exec 9>"$LOCK"
      if ! flock -n 9; then
        exit 0
      fi
      {
        echo "---- $(date -Is) instagram_refresh_token ----"
        python3 - "$APP_DIR" <<'PY'
      import glob
      import os
      import subprocess
      import sys

      app_dir = sys.argv[1]
      try:
          pid = subprocess.check_output(['pgrep', '-of', 'daphne'], text=True).strip()
      except subprocess.CalledProcessError as exc:
          raise SystemExit('Could not find the running Daphne process for EB environment') from exc

      env = os.environ.copy()
      with open('/proc/{}/environ'.format(pid), 'rb') as source:
          for item in source.read().split(b'\0'):
              if b'=' in item:
                  key, value = item.split(b'=', 1)
                  env[key.decode()] = value.decode()

      python = sorted(glob.glob('/var/app/venv/*/bin/python'))[-1]
      command = [python, 'manage.py', 'instagram_refresh_token']
      heartbeat = [python, 'manage.py', 'queue_heartbeat', '--queue', 'instagram_refresh_token']
      subprocess.run(heartbeat + ['--state', 'start'], cwd=app_dir, env=env, check=False)
      result = subprocess.run(command, cwd=app_dir, env=env, check=False)
      state = 'success' if result.returncode == 0 else 'failed'
      subprocess.run(heartbeat + ['--state', state, '--error', 'exit {}'.format(result.returncode)], cwd=app_dir, env=env, check=False)
      if result.returncode:
          raise SystemExit(result.returncode)
      PY
      } >>"$LOG" 2>&1

  "/etc/cron.d/interoves-instagram-refresh":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/sbin:/bin:/usr/sbin:/usr/bin
      17 3 * * * root /opt/interoves/instagram_refresh.sh

commands:
  01_instagram_refresh_log:
    command: "touch /var/log/instagram_refresh.log && chmod 644 /var/log/instagram_refresh.log"
