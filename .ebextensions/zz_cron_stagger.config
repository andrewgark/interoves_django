# Keep minute-level cron frequency while avoiding a same-second CPU burst.
# This runs after the individual cron configs and rewrites only the installed
# active entries.  The Word Salad entry is optional because older releases do
# not have that queue yet.
commands:
  99_stagger_interoves_cron:
    command: |
      set -eu
      for file in \
        /etc/cron.d/interoves-anonymous-merge \
        /etc/cron.d/interoves-daily-result-projection \
        /etc/cron.d/interoves-difficulty \
        /etc/cron.d/interoves-telegram \
        /etc/cron.d/interoves-word-salad-recheck
      do
        [ -f "$file" ] || continue
        tmp="$(mktemp /var/tmp/interoves-cron.XXXXXX)"
        sed -E \
          -e 's#^\* \* \* \* \* root /opt/interoves/anonymous_merge_cron\.sh$#* * * * * root sleep 0 \&\& /opt/interoves/anonymous_merge_cron.sh#' \
          -e 's#^\* \* \* \* \* root /opt/interoves/daily_result_projection_cron\.sh$#* * * * * root sleep 12 \&\& /opt/interoves/daily_result_projection_cron.sh#' \
          -e 's#^\* \* \* \* \* root /opt/interoves/difficulty_cron\.sh$#* * * * * root sleep 25 \&\& /opt/interoves/difficulty_cron.sh#' \
          -e 's#^\* \* \* \* \* root /opt/interoves/word_salad_recheck_cron\.sh$#* * * * * root sleep 38 \&\& /opt/interoves/word_salad_recheck_cron.sh#' \
          -e 's#^\* \* \* \* \* root /opt/interoves/telegram_cron\.sh$#* * * * * root sleep 50 \&\& /opt/interoves/telegram_cron.sh#' \
          "$file" > "$tmp"
        install -o root -g root -m 0644 "$tmp" "$file"
        rm -f -- "$tmp"
      done
