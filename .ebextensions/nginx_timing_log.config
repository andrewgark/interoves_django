# The live timing log uses /var/log/nginx/access.log so Elastic Beanstalk's
# built-in CloudWatch streaming picks it up. Keep it in EB bundle/tail output too.
files:
  "/opt/elasticbeanstalk/tasks/bundlelogs.d/nginx_timing.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/nginx/access.log

  "/opt/elasticbeanstalk/tasks/taillogs.d/nginx_timing.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/nginx/access.log
