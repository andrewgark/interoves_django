# Durable anonymous-profile merge queue.  Every EB instance may tick; DB row
# leases and fencing tokens prevent duplicate work across instances.
files:
  "/opt/interoves/anonymous_merge_cron.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail
      APP_DIR=/var/app/current
      LOG=/var/log/anonymous_merge_cron.log
      LOCK=/var/lock/anonymous_merge_cron.lock
      exec 9>"$LOCK"
      if ! flock -n 9; then
        exit 0
      fi
      {
        echo "---- $(date -Is) process_anonymous_merge_jobs ----"
        python3 - "$APP_DIR" <<'PY'
      import glob
      import os
      import subprocess
      import sys

      app_dir = sys.argv[1]
      pid = subprocess.check_output(['pgrep', '-of', 'daphne'], text=True).strip()
      env = os.environ.copy()
      with open('/proc/{}/environ'.format(pid), 'rb') as source:
          for item in source.read().split(b'\0'):
              if b'=' in item:
                  key, value = item.split(b'=', 1)
                  env[key.decode()] = value.decode()
      python = sorted(glob.glob('/var/app/venv/*/bin/python'))[-1]
      subprocess.run(
          [python, 'manage.py', 'process_anonymous_merge_jobs', '--limit', '1'],
          cwd=app_dir, env=env, check=True,
      )
      PY
      } >>"$LOG" 2>&1

  "/etc/cron.d/interoves-anonymous-merge":
    mode: "000644"
    owner: root
    group: root
    content: |
      SHELL=/bin/bash
      PATH=/sbin:/bin:/usr/sbin:/usr/bin
      * * * * * root /opt/interoves/anonymous_merge_cron.sh

commands:
  01_anonymous_merge_cron_log:
    command: "touch /var/log/anonymous_merge_cron.log && chmod 644 /var/log/anonymous_merge_cron.log"
