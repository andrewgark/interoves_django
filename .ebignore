# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# Never ship local git metadata or local virtualenv in EB bundles.
.git/
.venv/

# With .ebignore present EB packages the working tree, ignoring .gitignore.
# Keep local credentials, databases and runtime caches out of deployment archives.
secrets/
*.env
.env
db.sqlite3
google_token.pickle
media/
__pycache__/
*.pyc
.vscode/
.cursor/
.codex/
.agents/
var/eurovision_booklet/
nutrimatic_bundle/.s3_index_cache/

# nutrimatic_bundle may contain a ~350MB wiki-merged.index; keep it out of the app zip when the index
# is loaded from S3 (NUTRIMATIC_INDEX_S3_*). Remove these lines if you must ship the index in the bundle.
nutrimatic_bundle/*.index

# Eurovision booklet PDFs/HTML are large and can push EB app archives over 512MB.
# Prod serves lazily: per-file fetch into var/eurovision_booklet/2026/ from PINNED_REF
# (AUTO_SYNC off). See microsites/views.py.
static/microsites/eurovision_booklet/2026/*.pdf
static/microsites/eurovision_booklet/2026/html/
static/microsites/eurovision_booklet/2026/assets/
