{
  "metrics": {
    "namespace": "InterOves/Web",
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}"
    },
    "aggregation_dimensions": [
      ["AutoScalingGroupName"]
    ],
    "metrics_collected": {
      "cpu": {
        "measurement": ["usage_active"],
        "totalcpu": true,
        "drop_original_metrics": ["cpu_usage_active"],
        "metrics_collection_interval": 60
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": ["free"],
        "resources": ["/"],
        "ignore_file_system_types": ["sysfs", "devtmpfs", "tmpfs", "overlay"],
        "drop_original_metrics": ["disk_free"],
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/interoves/kernel.log",
            "log_group_name": "/aws/elasticbeanstalk/interoves-web-green-lb/kernel",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/interoves/systemd.log",
            "log_group_name": "/aws/elasticbeanstalk/interoves-web-green-lb/systemd",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
