[Unit]
Description=Inter Oves recheck outbox dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/app/current
EnvironmentFile=-/opt/elasticbeanstalk/deploy/configuration/containerconfiguration
ExecStart=/bin/bash -lc 'while true; do /var/app/venv/*/bin/python manage.py dispatch_recheck_outbox_loop --limit 25 --interval 3; done'
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
