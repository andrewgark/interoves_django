packages:
  yum:
    atk: []
    at-spi2-atk: []
    cups-libs: []
    libdrm: []
    libXcomposite: []
    libXdamage: []
    libXrandr: []
    mesa-libgbm: []
    pango: []
    alsa-lib: []
    nss: []
    nspr: []
    libxkbcommon: []
    gtk3: []
    google-noto-emoji-color-fonts: []
    google-noto-emoji-fonts: []
    dejavu-sans-fonts: []

container_commands:
  04_playwright_chromium:
    command: >-
      source /var/app/venv/*/bin/activate &&
      mkdir -p /home/app/.cache/ms-playwright /home/app/.fonts &&
      PLAYWRIGHT_BROWSERS_PATH=/home/app/.cache/ms-playwright
      python -m playwright install chromium &&
      (cp -f /usr/share/fonts/google-noto-emoji/NotoColorEmoji.ttf /home/app/.fonts/ 2>/dev/null ||
       cp -f /usr/share/fonts/noto/NotoColorEmoji.ttf /home/app/.fonts/ 2>/dev/null || true) &&
      chown -R app:app /home/app/.cache/ms-playwright /home/app/.fonts
