# Template only. Not applied by deploy.sh.
# Timeouts from Green cron_finished job=daily_difficulty_refresh on 26 Sep 2026:
# 712 samples on one instance, p95 445ms, max 1749ms, including real refreshes.
# 60s inactivity is ~30x that max and still under the 600s Redis lock.
# Do not treat these as a license to copy Word Salad 180/120/8 onto other jobs.
option_settings:
  aws:ec2:instances:
    InstanceTypes: t3.medium
    EnableSpot: 'false'
  aws:autoscaling:launchconfiguration:
    DisableIMDSv1: 'true'
    SSHSourceRestriction: tcp,22,22,127.0.0.1/32
  aws:elasticbeanstalk:application:environment:
    INTEROVES_RUNTIME_ROLE: background-worker
  aws:elasticbeanstalk:sqsd:
    WorkerQueueURL: __SET_FROM_BACKGROUND_QUEUE__
    HttpPath: /internal/worker/background/
    MimeType: application/json
    HttpConnections: '1'
    ConnectTimeout: '5'
    InactivityTimeout: '60'
    VisibilityTimeout: '90'
    ErrorVisibilityTimeout: '30'
    MaxRetries: '3'
  aws:autoscaling:asg:
    MinSize: '1'
    MaxSize: '1'
  aws:autoscaling:updatepolicy:rollingupdate:
    RollingUpdateEnabled: 'false'
