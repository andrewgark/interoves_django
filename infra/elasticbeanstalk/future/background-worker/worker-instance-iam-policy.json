{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReceiveBackgroundMessages",
      "Effect": "Allow",
      "Action": [
        "sqs:ChangeMessageVisibility",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ReceiveMessage"
      ],
      "Resource": "arn:aws:sqs:eu-central-1:916000456640:interoves-background"
    },
    {
      "Sid": "WorkerSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:eu-central-1:916000456640:secret:rds!db-ce1a594a-9964-4a32-a9d3-9483ada5368c-0O6ead",
        "arn:aws:secretsmanager:eu-central-1:916000456640:secret:interoves/production/*"
      ]
    },
    {
      "Sid": "WorkerMetrics",
      "Effect": "Allow",
      "Action": ["cloudwatch:PutMetricData"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "InterOves/Worker"
        }
      }
    },
    {
      "Sid": "CloudWatchAgentEc2Dimensions",
      "Effect": "Allow",
      "Action": ["ec2:DescribeTags"],
      "Resource": "*"
    },
    {
      "Sid": "WorkerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "__WORKER_LOG_GROUP_ARN__:log-stream:*"
    }
  ]
}
