{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeConfiguredWorkerQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "__WORKER_QUEUE_ARN__"
    },
    {
      "Sid": "ReadWorkerRuntimeConfiguration",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "__WORKER_CONFIG_SECRET_ARN__"
    }
  ]
}
