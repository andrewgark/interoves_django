.git
.gitignore
.dockerignore
.elasticbeanstalk
.venv
venv
secrets
*.env
.env
db.sqlite3
media
tmp
var
# Static assets stay out of worker images, but the site templates live in
# static/templates: without them worker jobs that render HTML (live task
# card updates after a recheck) failed with TemplateDoesNotExist.
static/*
!static/templates
nutrimatic_bundle
reports
__pycache__
*.pyc
.vscode
.cursor
.codex
.agents
nutrimatic_bundle/*.index
static/microsites/eurovision_booklet/2026/*.pdf
static/microsites/eurovision_booklet/2026/html
static/microsites/eurovision_booklet/2026/assets
